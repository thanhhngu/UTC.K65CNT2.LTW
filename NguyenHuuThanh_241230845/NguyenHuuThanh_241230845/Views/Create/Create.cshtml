@model NguyenHuuThanh_241230845.ViewModels.CreateHang

<form asp-action="Create" method="post" enctype="multipart/form-data">
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<div class="form-group">
		<label asp-for="MaLoai" class="control-label"></label>
		<select asp-for="MaLoai" class="form-control" asp-items="ViewBag.LoaiHangs">

		</select>
		<span asp-validation-for="MaLoai" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="TenHang"></label>
		<input asp-for="TenHang" class="form-control" />
		<span asp-validation-for="TenHang" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Gia"></label>
		<input asp-for="Gia" class="form-control" />
		<span asp-validation-for="Gia" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Anh"></label>
		<input asp-for="Anh" class="form-control" />
		<span asp-validation-for="Anh" class="text-danger"></span>
	</div>
	<button type="submit" class="btn btn-primary">Create</button>
</form>

		@section Scripts {
	<partial name="_ValidationScriptsPartial" />
		}