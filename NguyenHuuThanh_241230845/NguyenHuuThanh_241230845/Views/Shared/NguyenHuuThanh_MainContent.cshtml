@model IEnumerable<NguyenHuuThanh_241230845.Models.HangHoa>
<div class="main">
	<div class="content">
		<!-- Begin New Product -->
		<div class="content_top">
			<div class="heading">
				<h3>New Products</h3>
			</div>
			<div class="see">
				<p><a href="#">See all Products</a></p>
			</div>
			<div class="clear"></div>
		</div>
		<div class="section group">
			@foreach (var item in Model)
			{
				<div class="grid_1_of_4 images_1_of_4">
					<a href="preview.html"><img src="images/@item.Anh" alt="" /></a>
					<h2>@item.TenHang</h2>
					<div class="price-details">
						<div class="price-number">
							<p><span class="rupees">$@item.Gia.ToString()</span></p>
						</div>
						<div class="add-cart">
							<h4><a href="preview.html">Add to Cart</a></h4>
						</div>
						<div class="clear"></div>
					</div>
				</div>
			}
		</div>
	</div>
</div>
<!-- End Main -->