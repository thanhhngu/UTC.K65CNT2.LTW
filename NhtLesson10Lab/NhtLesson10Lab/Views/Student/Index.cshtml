@model IEnumerable<NhtLesson10Lab.Models.Student>

@{
    ViewData["Title"] = "Index";
	Layout = "_MyLayout"; // Sử dụng layout _MyLayout.cshtml
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Password)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Branch)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IsRegular)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Address)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Date0fBorth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Avatar)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Email)
            </td>
            <td>
                @Html.DisplayFor(model => item.Password)
            </td>
            <td>
                @Html.DisplayFor(model => item.Branch)
            </td>
            <td>
                @Html.DisplayFor(model => item.Gender)
            </td>
            <td>
                @Html.DisplayFor(model => item.IsRegular)
            </td>
            <td>
                @Html.DisplayFor(model => item.Address)
            </td>
            <td>
                @Html.DisplayFor(model => item.Date0fBorth)
            </td>
            <td>
                    @if (!string.IsNullOrEmpty(item.Avatar))
                    {
                        <img src="~/images/@item.Avatar" alt="Avatar" width="50" height="50" style="object-fit: cover; border-radius: 50%;" />
                    }
                    else
                    {
                        <!-- Ảnh mặc định nếu sinh viên chưa có avatar -->
                        <img src="~/images/default-avatar.png" alt="No Avatar" width="50" height="50" style="object-fit: cover; border-radius: 50%;" />
                    }
            </td>

            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>

@section Scripts {
	<script>
		var table = document.querySelector('table');
        table.onclick = function OnTableClick() {
            table.style.setProperty('--bs-table-bg', 'lightblue');
        }
	</script>
}
