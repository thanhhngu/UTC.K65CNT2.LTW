@model IEnumerable<NhtLesson11Lab04.Models.Learner>

<p>
    <a asp-action="Create">Create New</a>
</p>
@await Component.InvokeAsync("Major")
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstMidName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EnrollmentDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MajorID)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Major)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Enrollments)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.FirstMidName)
                </td>
                <td>
                    @Html.DisplayFor(model => item.EnrollmentDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MajorID)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Major.MajorName)
                </td>
                <td>
                    @if (item.Enrollments is { Count: > 0 })
                    {
                        foreach (var enrollment in item.Enrollments)
                        {
                            <div>@enrollment.Course?.Title (@enrollment.Grade)</div>
                        }
                    }
                    else
                    {
                        <span>No enrollments</span>
                    }
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.LearnerID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.LearnerID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.LearnerID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<ul class="pagination">
    @for (int i = 1; i <= ViewBag.pageNum; i++)
    {
        <li class="page-item" style="cursor: pointer;" page="@i"
            @(ViewBag.mid != null ? $"mid={ViewBag.mid}" : "")
            @(ViewBag.keyword != null ? $"keyword={ViewBag.keyword}" : "")>
            <a class="page-link">@i</a>
        </li>
    }
</ul>
