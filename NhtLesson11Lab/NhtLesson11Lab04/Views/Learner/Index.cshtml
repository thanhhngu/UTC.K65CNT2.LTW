@model IEnumerable<NhtLesson11Lab04.Models.Learner>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
@await Component.InvokeAsync("Major")
<form class="d-none d-md-inline-block form-check-inline ms-auto me-0 me-md-3 my-2 my-md-0">
    <div class="form-group">
		<input type="text" class="form-control" id="keyword" name="keyword" placeholder="Search by last name..." />
		<button type="button" class="btn btn-primary" id="searchButton"><i class="fas fa-search"></i></button>

    </div>
</form>
<div id="content">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.LastName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.FirstMidName)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.EnrollmentDate)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.MajorID)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Major)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Enrollments)
                </th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(model => item.LastName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.FirstMidName)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.EnrollmentDate)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.MajorID)
                    </td>
                    <td>
                        @Html.DisplayFor(model => item.Major.MajorName)
                    </td>
                    <td>
                        @if (item.Enrollments is { Count: > 0 })
                        {
                            foreach (var enrollment in item.Enrollments)
                            {
                                <div>@enrollment.Course?.Title (@enrollment.Grade)</div>
                            }
                        }
                        else
                        {
                            <span>No enrollments</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.LearnerID">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.LearnerID">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.LearnerID">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

	<ul class="pagination">
		@for (int i = 1; i <= ViewBag.pageNumber; i++)
		{
            <li class="page-item"
                page="@i"
                @(ViewBag.mid != null ? $"mid={ViewBag.mid}" : "")
                @(ViewBag.keyword != null ? $"keyword='{ViewBag.keyword}'" : "")>
                <a class="page-link" href="#" data-page="@i">@i</a>
            </li>
		}
    </ul>

</div>


@section Scripts {
	<script>
		// $("li").click(function(e) {
  //        var id = $(this).attr('id');
		// 	$.ajax({
		// 		url: '@Url.Action("GetLearnersByMajor", "Learner")',
		// 		type: 'GET',
		// 		data: { mid: id },
		// 		success: function(result) {
		// 			$('div#content').html(result);
		// 		}
		// 	});
  //       });

        $("body").on("click", "li.page-item", function(e) {
			var page = $(this).attr('page');
			var mid = $(this).attr('mid');
			var keyword = $(this).attr('keyword');
			var data = {mid: mid, keyword: keyword, pageIndex: page};
			$.ajax({
                url: '@Url.Action("LearnerFilter", "Learner")',
                type: 'GET',
                data: data,
                success: function(result) {
                    $('div#content').html(result);
                }
            })
        })

        $(".nav li").click(function(e) {
            e.preventDefault();
            var id = $(this).attr("id");
            var keyword = $("#keyword").val();

            var data = { mid: id, keyword: keyword, pageIndex: 1 };
            $.ajax({
                url: '@Url.Action("LearnerFilter", "Learner")',

                data: data,
                success: function(response) {
                    $("div#content").html(response);
                }
            });
        });
        $("button#searchButton").click(function(e) {
            e.preventDefault();
            var keyword = $("#keyword").val();

            var data = { keyword: keyword, pageIndex: 1 };
            $.ajax({
                url: '@Url.Action("LearnerFilter", "Learner")',

                data: data,
                success: function(response) {
                    $("div#content").html(response);
                }
            });
        });
	</script>
}