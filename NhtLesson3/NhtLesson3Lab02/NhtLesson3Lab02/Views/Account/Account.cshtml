    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
	ViewData["Title"] = "Account";
    var accounts = ViewBag.accounts;
}

<div class="row">
    @foreach (var account in accounts)
    {
        <div class="col-md-4">
            <div class="thumbnail">
                <img src="@Url.Content(account.Avatar)" alt="Avatar">
                <div class="caption">
                    <h3>@account.Name</h3>
                    <p>
                        @account.Bio
                    </p>
                    <p>
                        <a asp-route="Profile" asp-route-id = "@account.Id" class="btn btn-success btn-block">Profile</a>
                    </p>
                </div>
            </div>
        </div>
    }
</div>