@model IEnumerable<NguyenHuuThanh_241230845_QLTS2.Models.TaiSan>

@foreach(var item in @Model)
{
    <div class="asset-card">
        <a href="#"><img src="images/@item.Anh" alt="" /></a>
        <h2>@item.TenTs</h2>
        <div class="asset-foot"><span class="price">@item.NguyenGia tr</span><button class="btn-buy">Chi tiết</button></div>
        <button ><a asp-action="Edit" asp-controller="TaiSan" asp-route-id="@item.MaTs">Sua</a></button>
    </div>
}